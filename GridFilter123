/* Place this constant OUTSIDE your DataGrid component.
   Replace your earlier GRID_FILTER_ICONS declaration. */
const GRID_FILTER_ICONS = {
  filter: `
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M3 4h18l-7 8v7l-4 2v-9L3 4z" />
    </svg>
  `,
};

/* Place this function OUTSIDE your DataGrid component.
   Replace your earlier positionFilterPopup function. */
function positionFilterPopup(
  params: PostProcessPopupParams,
): void {
  const source = params.eventSource;

  if (!source) return;

  const filterCell = source.closest<HTMLElement>(
    '.ag-header-cell.ag-floating-filter',
  );

  // Only customise popups opened from the floating-filter row.
  if (!filterCell) return;

  const popup = params.ePopup;

  // Attach styling directly because the popup is under document.body.
  popup.classList.add('risk-grid-filter-popup');

  requestAnimationFrame(() => {
    if (!popup.isConnected || !filterCell.isConnected) return;

    const gap = 6;
    const edgePadding = 10;

    const cellRect = filterCell.getBoundingClientRect();
    const iconRect = source.getBoundingClientRect();

    const viewportWidth = document.documentElement.clientWidth;
    const viewportHeight = document.documentElement.clientHeight;

    const desiredTop = cellRect.bottom + gap;
    const availableHeight =
      viewportHeight - desiredTop - edgePadding;

    // Retain AG Grid's placement if no room exists below the row.
    if (availableHeight <= 0) return;

    popup.style.maxHeight = `${availableHeight}px`;
    popup.style.maxWidth = `${
      viewportWidth - edgePadding * 2
    }px`;
    popup.style.overflowY = 'auto';
    popup.style.boxSizing = 'border-box';

    const popupRect = popup.getBoundingClientRect();

    // Align under the icon unless that would exceed the screen edge.
    const desiredLeft = Math.max(
      edgePadding,
      Math.min(
        iconRect.left,
        viewportWidth - popupRect.width - edgePadding,
      ),
    );

    // Adjust the existing position without assuming parent coordinates.
    const currentLeft =
      Number.parseFloat(popup.style.left) || 0;

    const currentTop =
      Number.parseFloat(popup.style.top) || 0;

    popup.style.left = `${
      currentLeft + desiredLeft - popupRect.left
    }px`;

    popup.style.top = `${
      currentTop + desiredTop - popupRect.top
    }px`;
  });
}

