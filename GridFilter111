import type {
  ColDef,
  ColGroupDef,
  ISetFilterParams,
  ValueFormatterFunc,
} from 'ag-grid-community';

/**
 * Creates a number formatter for both grid cells and filter values.
 *
 * divisor: 1
 * Use when API values are already in millions.
 * Example: 2.62344 -> 2.62
 *
 * divisor: 1_000_000
 * Use when API values are in dollars.
 * Example: 2623440 -> 2.62
 *
 * Formatting does not change the underlying row data.
 */
export function createNumberFormatter<TData = unknown>(
  options: {
    divisor?: number;
    decimals?: number;
    locale?: string;
    useGrouping?: boolean;
  } = {},
): ValueFormatterFunc<TData> {
  const {
    divisor = 1,
    decimals = 2,
    locale = 'en-US',
    useGrouping = true,
  } = options;

  if (!Number.isFinite(divisor) || divisor <= 0) {
    throw new Error('divisor must be a positive finite number.');
  }

  if (
    !Number.isInteger(decimals) ||
    decimals < 0 ||
    decimals > 20
  ) {
    throw new Error('decimals must be an integer between 0 and 20.');
  }

  const numberFormatter = new Intl.NumberFormat(locale, {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
    useGrouping,
  });

  return ({ value }) => {
    if (
      value == null ||
      (typeof value === 'string' && value.trim() === '')
    ) {
      return '';
    }

    if (
      typeof value !== 'number' &&
      typeof value !== 'string'
    ) {
      return String(value);
    }

    const numericValue = Number(value);

    if (!Number.isFinite(numericValue)) {
      return String(value);
    }

    const scaledValue = numericValue / divisor;

    // Avoid displaying -0.00 for small negative numbers.
    const displayValue =
      Number(scaledValue.toFixed(decimals)) === 0
        ? 0
        : scaledValue;

    return numberFormatter.format(displayValue);
  };
}

export interface SetFilterOptions<TData> {
  /**
   * Optional formatters for specific columns.
   * Keys must match colId, or field when colId is not defined.
   * Do not use headerName: COB/PCOB headers may repeat.
   *
   * These formatters apply to both cells and filter labels.
   */
  formatters?: Readonly<
    Record<string, ValueFormatterFunc<TData>>
  >;

  /**
   * Optional formatter inherited from defaultColDef.
   * Must work using params.value without needing params.data/node.
   */
  defaultValueFormatter?: ValueFormatterFunc<TData>;

  /**
   * true hides Select All, matching your third screenshot.
   * Set false if you want Select All.
   */
  hideSelectAll?: boolean;
}

/**
 * Adds searchable Set Filters with Reset/Apply buttons.
 *
 * Supports nested column groups, including COB/PCOB groups.
 * Preserves existing cell renderers, getters and other column options.
 * Leaves filter:false and explicitly configured other filters unchanged.
 *
 * Requires AG Grid Enterprise Set Filter.
 * Your first screenshot already shows this filter.
 */
export function withSetFilters<TData>(
  definitions: ReadonlyArray<
    ColDef<TData> | ColGroupDef<TData>
  >,
  options: SetFilterOptions<TData> = {},
): Array<ColDef<TData> | ColGroupDef<TData>> {
  return definitions.map((definition) => {
    // Recursively process grouped columns.
    if ('children' in definition) {
      return {
        ...definition,
        children: withSetFilters(
          definition.children,
          options,
        ),
      };
    }

    const column = definition;

    // Preserve disabled filters and other explicit filter types.
    if (
      column.filter === false ||
      (
        column.filter != null &&
        column.filter !== true &&
        column.filter !== 'agSetColumnFilter'
      )
    ) {
      return { ...column };
    }

    const columnId = column.colId ?? column.field;

    const overrideFormatter =
      columnId == null
        ? undefined
        : options.formatters?.[columnId];

    const existingFormatter =
      typeof column.valueFormatter === 'function'
        ? column.valueFormatter
        : undefined;

    const displayFormatter =
      overrideFormatter ??
      existingFormatter ??
      options.defaultValueFormatter;

    const existingFilterParams = (
      column.filterParams ?? {}
    ) as Partial<ISetFilterParams<TData>>;

    const filterParams: Partial<ISetFilterParams<TData>> = {
      ...existingFilterParams,

      // Buttons displayed at the bottom of the popup.
      buttons: ['reset', 'apply'],

      // Close popup after applying the filter.
      closeOnApply: true,

      // Show search box.
      suppressMiniFilter: false,

      // Hide Select All by default, as in your reference.
      suppressSelectAll: options.hideSelectAll ?? true,

      // Searching should narrow the checklist.
      // It should not immediately apply a grid filter.
      applyMiniFilterWhileTyping: false,

      // Space between checkbox rows.
      cellHeight: 36,
    };

    if (displayFormatter) {
      filterParams.valueFormatter = (params) => {
        if (
          params.value == null ||
          params.value === ''
        ) {
          return '(Blanks)';
        }

        return displayFormatter(params);
      };
    }

    return {
      ...column,

      // Explicit formatter overrides affect cell text too.
      ...(overrideFormatter
        ? { valueFormatter: overrideFormatter }
        : {}),

      filter: 'agSetColumnFilter',
      floatingFilter: true,
      filterParams,
    };
  });
}

