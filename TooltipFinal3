import Highcharts from 'highcharts';
/**
 * Defines one value column in the tooltip.
 *
 * Example:
 * {
 *   key: 'mc',
 *   label: 'MC',
 *   seriesPrefix: 'MC '
 * }
 */
export interface TooltipValueColumn {
  key: string;
  label: string;
  /**
   * Used to decide which series belongs to this column.
   *
   * Example:
   * "MC FXVG" -> MC column
   */
  seriesPrefix?: string;
  /**
   * Optional custom matcher.
   *
   * Use this when prefix matching is not enough.
   */
  matchSeries?: (seriesName: string) => boolean;
}
/**
 * Configuration passed by a chart to CommonChart.
 */
export interface CommonChartTooltipConfig {
  /**
   * table:
   *
   * FS Type | MC | Hist
   *
   * list:
   *
   * MC VaR       117.51
   * MC SVaR      170.38
   */
  mode?: 'table' | 'list';
  /**
   * First column heading.
   *
   * Example:
   * FS Type
   * Risk Type
   * Desk
   * Region
   */
  categoryLabel?: string;
  /**
   * Value columns.
   */
  columns?: TooltipValueColumn[];
  /**
   * Removes something from the beginning of
   * the series name before displaying it.
   *
   * Example:
   *
   * ["MC ", "Hist "]
   *
   * MC FXVG   -> FXVG
   * Hist FXVG -> FXVG
   *
   * Leave undefined if you DON'T want anything removed.
   */
  removeSeriesPrefixes?: string[];
  /**
   * Series that should be displayed separately
   * below the main table.
   *
   * Example:
   *
   * MC CVaR Trend
   * Hist CVaR Trend
   */
  footerSeriesMatcher?: (seriesName: string) => boolean;
  /**
   * Number of decimals.
   */
  valueDecimals?: number;
  /**
   * Sort rows by their values.
   */
  sortDescending?: boolean;
  /**
   * Optional formatter for displayed values.
   */
  formatValue?: (
    value: number,
    seriesName: string
  ) => string;
}
/**
 * Internal grouped row.
 */
interface TooltipGroupedRow {
  name: string;
  color: string;
  values: Record<string, number | undefined>;
}
/**
 * Safely gets point color.
 */
function getPointColor(
  point: Highcharts.Point
): string {
  if (typeof point.color === 'string') {
    return point.color;
  }
  if (typeof point.series.color === 'string') {
    return point.series.color;
  }
  return '#666666';
}
/**
 * Removes configured prefixes from the
 * displayed series name.
 */
function getDisplayName(
  seriesName: string,
  prefixes?: string[]
): string {
  let result = seriesName.trim();
  if (!prefixes?.length) {
    return result;
  }
  prefixes.forEach((prefix) => {
    if (
      result
        .toLowerCase()
        .startsWith(prefix.toLowerCase())
    ) {
      result = result
        .slice(prefix.length)
        .trim();
    }
  });
  return result;
}
/**
 * Determines whether a series belongs to
 * a configured tooltip column.
 */
function matchesColumn(
  seriesName: string,
  column: TooltipValueColumn
): boolean {
  if (column.matchSeries) {
    return column.matchSeries(seriesName);
  }
  if (column.seriesPrefix) {
    return seriesName
      .toLowerCase()
      .startsWith(
        column.seriesPrefix.toLowerCase()
      );
  }
  return true;
}
/**
 * Value formatting.
 */
function formatTooltipValue(
  value: number,
  seriesName: string,
  config: CommonChartTooltipConfig
): string {
  if (config.formatValue) {
    return config.formatValue(
      value,
      seriesName
    );
  }
  return Highcharts.numberFormat(
    value,
    config.valueDecimals ?? 1
  );
}
/**
 * Gets tooltip date/category.
 */
function getTooltipCategory(
  context: Highcharts.TooltipFormatterContextObject,
  points: Highcharts.Point[]
): string | number {
  const firstPoint = points[0];
  if (!firstPoint) {
    return '';
  }
  const categoryIndex = firstPoint.x;
  if (typeof categoryIndex === 'number') {
    const category =
      firstPoint.series.xAxis.categories?.[
        categoryIndex
      ];
    if (category !== undefined) {
      return category;
    }
  }
  return context.x ?? '';
}
/**
 * Creates footer HTML.
 *
 * Generic — it doesn't know anything about
 * CVaR or MC/Hist.
 */
function buildFooterHtml(
  points: Highcharts.Point[],
  config: CommonChartTooltipConfig
): string {
  if (!config.footerSeriesMatcher) {
    return '';
  }
  const footerPoints = points.filter((point) =>
    config.footerSeriesMatcher!(
      point.series.name
    )
  );
  if (!footerPoints.length) {
    return '';
  }
  const rows = footerPoints
    .map((point) => {
      const value = point.y ?? 0;
      return `
        <div class="chart-tooltip-footer-row">
          <span class="chart-tooltip-footer-name">
            <span
              class="chart-tooltip-line-marker"
              style="background:${getPointColor(
                point
              )}"
            ></span>
            ${point.series.name}
          </span>
          <strong>
            ${formatTooltipValue(
              value,
              point.series.name,
              config
            )}
          </strong>
        </div>
      `;
    })
    .join('');
  return `
    <div class="chart-tooltip-footer">
      ${rows}
    </div>
  `;
}
/**
 * ---------------------------------------------------------
 * LIST TOOLTIP
 * ---------------------------------------------------------
 *
 * Useful for ordinary line charts:
 *
 * MC VaR        117.51
 * MC SVaR       170.38
 * Hist VaR      123.28
 * Hist SVaR     175.47
 */
function buildListTooltip(
  date: string | number,
  points: Highcharts.Point[],
  config: CommonChartTooltipConfig
): string {
  const rows = points
    .map((point) => {
      const value = point.y ?? 0;
      return `
        <div class="chart-tooltip-list-row">
          <span class="chart-tooltip-list-name">
            <span
              class="chart-tooltip-dot"
              style="background:${getPointColor(
                point
              )}"
            ></span>
            ${point.series.name}
          </span>
          <strong>
            ${formatTooltipValue(
              value,
              point.series.name,
              config
            )}
          </strong>
        </div>
      `;
    })
    .join('');
  return `
    <div class="chart-tooltip">
      <div class="chart-tooltip-date">
        ${date}
      </div>
      <div class="chart-tooltip-list">
        ${rows}
      </div>
    </div>
  `;
}
/**
 * ---------------------------------------------------------
 * TABLE TOOLTIP
 * ---------------------------------------------------------
 *
 * Supports:
 *
 * FS Type | MC
 *
 * FS Type | Hist
 *
 * FS Type | MC | Hist
 *
 * Region | Actual | Limit | Forecast
 *
 * etc.
 */
function buildTableTooltip(
  date: string | number,
  points: Highcharts.Point[],
  config: CommonChartTooltipConfig
): string {
  const columns =
    config.columns?.length
      ? config.columns
      : [
          {
            key: 'value',
            label: 'Value',
          },
        ];
  /*
   * Footer points are removed from the main
   * table automatically.
   */
  const dataPoints =
    config.footerSeriesMatcher
      ? points.filter(
          (point) =>
            !config.footerSeriesMatcher!(
              point.series.name
            )
        )
      : points;
  const groupedRows = new Map<
    string,
    TooltipGroupedRow
  >();
  dataPoints.forEach((point) => {
    const seriesName = point.series.name;
    const displayName = getDisplayName(
      seriesName,
      config.removeSeriesPrefixes
    );
    let row = groupedRows.get(displayName);
    if (!row) {
      row = {
        name: displayName,
        color: getPointColor(point),
        values: {},
      };
      groupedRows.set(displayName, row);
    }
    /*
     * Find which configured column this
     * series belongs to.
     */
    const column = columns.find((item) =>
      matchesColumn(seriesName, item)
    );
    if (column) {
      row.values[column.key] =
        point.y ?? 0;
    }
  });
  let rows = Array.from(
    groupedRows.values()
  );
  /*
   * Optional sorting.
   *
   * Uses the highest available value in
   * each row.
   */
  if (config.sortDescending) {
    rows = rows.sort((a, b) => {
      const aValues = Object.values(
        a.values
      ).filter(
        (value): value is number =>
          typeof value === 'number'
      );
      const bValues = Object.values(
        b.values
      ).filter(
        (value): value is number =>
          typeof value === 'number'
      );
      const aMax = aValues.length
        ? Math.max(...aValues)
        : 0;
      const bMax = bValues.length
        ? Math.max(...bValues)
        : 0;
      return bMax - aMax;
    });
  }
  /*
   * Dynamic table header.
   */
  const header = `
    <tr>
      <th>
        ${config.categoryLabel ?? 'Series'}
      </th>
      ${columns
        .map(
          (column) =>
            `<th>${column.label}</th>`
        )
        .join('')}
    </tr>
  `;
  /*
   * Dynamic rows.
   */
  const rowsHtml = rows
    .map((row) => {
      const valuesHtml = columns
        .map((column) => {
          const value =
            row.values[column.key];
          return `
            <td class="chart-tooltip-number">
              ${
                value !== undefined
                  ? formatTooltipValue(
                      value,
                      row.name,
                      config
                    )
                  : '-'
              }
            </td>
          `;
        })
        .join('');
      return `
        <tr>
          <td class="chart-tooltip-name">
            <span
              class="chart-tooltip-dot"
              style="background:${row.color}"
            ></span>
            <span>
              ${row.name}
            </span>
          </td>
          ${valuesHtml}
        </tr>
      `;
    })
    .join('');
  const footerHtml = buildFooterHtml(
    points,
    config
  );
  return `
    <div class="chart-tooltip">
      <div class="chart-tooltip-date">
        ${date}
      </div>
      <div class="chart-tooltip-content">
        <table class="chart-tooltip-table">
          <thead>
            ${header}
          </thead>
          <tbody>
            ${rowsHtml}
          </tbody>
        </table>
        ${footerHtml}
      </div>
    </div>
  `;
}
/**
 * =========================================================
 * PUBLIC FORMATTER
 * =========================================================
 *
 * This is the ONLY function CommonChart needs.
 */
export function buildCommonChartTooltip(
  context: Highcharts.TooltipFormatterContextObject,
  config: CommonChartTooltipConfig
): string {
  const points = context.points ?? [];
  if (!points.length) {
    return '';
  }
  const date = getTooltipCategory(
    context,
    points
  );
  if (config.mode === 'table') {
    return buildTableTooltip(
      date,
      points,
      config
    );
  }
  /*
   * Default = list.
   */
  return buildListTooltip(
    date,
    points,
    config
  );
}

