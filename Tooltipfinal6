const toTooltipConfig = (
  config?: WidgetChartTooltipConfig
): CommonChartTooltipConfig | undefined => {
  if (!config) {
    return undefined;
  }

  return {
    mode: config.mode ?? 'table',

    categoryLabel: config.categoryLabel ?? 'Category',

    columns: config.columns ?? [],

    removeSeriesPrefixes: config.removeSeriesPrefixes ?? [],

    sortDescending: config.sortDescending ?? false,

    valueDecimals: config.valueDecimals ?? 1,

    footerSeriesMatcher: config.footerSeriesContains
      ? (seriesName: string) => {
          const normalizedSeriesName = seriesName
            .trim()
            .toLowerCase();

          const footerText = config.footerSeriesContains!
            .trim()
            .toLowerCase();

          return normalizedSeriesName.includes(footerText);
        }
      : undefined,
  };
};



