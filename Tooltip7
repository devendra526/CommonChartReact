.chart-tooltip-more td {
  padding: 7px 6px;
  color: #2563eb;
  font-weight: 600;
  border-top: 1px solid #e5e7eb;
}

.chart-tooltip-total td {
  padding: 8px 6px;
  font-weight: 700;
  color: #111827;
  border-top: 1px solid #d1d5db;
}

.chart-tooltip-trend {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-top: 2px;
  padding: 8px 6px 3px;

  border-top: 1px solid #e5e7eb;
  font-weight: 600;
}

.chart-tooltip-total td:nth-child(2),
.chart-tooltip-total td:nth-child(3) {
  text-align: right;
}
