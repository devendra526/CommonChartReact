.chart-tooltip {
  min-width: 300px;
  padding: 6px;
  font-size: 12px;
  color: #1f2937;
}

.chart-tooltip-date {
  font-size: 14px;
  font-weight: 700;
  color: #111827;
  padding: 4px 6px 8px;
  margin-bottom: 4px;
  border-bottom: 1px solid #e5e7eb;
}

.chart-tooltip-table {
  width: 100%;
  border-collapse: collapse;
}

.chart-tooltip-table th {
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  color: #4b5563;
  padding: 5px 6px;
}

.chart-tooltip-table td {
  padding: 3px 6px;
}

.chart-tooltip-value,
.chart-tooltip-percent {
  text-align: right;
}
