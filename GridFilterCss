/* ==========================================================
   FLOATING FILTER ROW
   Wrapper must include: left-filter-grid
   ========================================================== */

.left-filter-grid .ag-header-cell.ag-floating-filter {
  padding-left: 8px !important;
  padding-right: 8px !important;
}

/* Blank space beside the icon; popup search is unaffected. */
.left-filter-grid .ag-floating-filter-body {
  display: none !important;
}

/* Left-aligned filter button. */
.left-filter-grid .ag-floating-filter-button {
  position: absolute !important;
  left: 8px !important;
  right: auto !important;
  top: 50% !important;
  transform: translateY(-50%);
  display: flex !important;
  align-items: center;
  justify-content: center;
  flex: none !important;
  width: 24px !important;
  height: 24px !important;
  margin: 0 !important;
  padding: 0 !important;
}

.left-filter-grid .ag-floating-filter-button-button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 24px !important;
  height: 24px !important;
  padding: 0 !important;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: #52676b;
  cursor: pointer;
}

.left-filter-grid .ag-floating-filter-button-button:hover {
  background: #e8f2f8;
  color: #087eae;
}

/* Small icon with a larger clickable area. */
.left-filter-grid .ag-floating-filter-button .ag-icon {
  --ag-icon-size: 13px;
  width: 13px !important;
  height: 13px !important;
  font-size: 13px !important;
  line-height: 13px !important;
}

.left-filter-grid .ag-floating-filter-button svg {
  display: block;
  width: 13px !important;
  height: 13px !important;
}

.left-filter-grid
  .ag-floating-filter-button-button:focus-visible {
  outline: 2px solid #1684b8;
  outline-offset: 2px;
}


/* ==========================================================
   POPUP
   Attached to document.body, so do not prefix popup rules
   with .left-filter-grid.
   ========================================================== */

.risk-grid-filter-popup {
  --ag-font-size: 13px;
  --ag-background-color: #ffffff;
  --ag-foreground-color: #243746;
  --ag-border-color: #d8e2eb;
  --ag-input-focus-border-color: #1684b8;
  --ag-checkbox-checked-color: #0785b5;

  box-sizing: border-box;
  width: 240px !important;
  min-width: 0 !important;
  border: 1px solid #d8e2eb !important;
  border-radius: 8px !important;
  background: #ffffff;
  color: #243746;

  /* Only the checkbox viewport should scroll. */
  overflow: hidden !important;

  box-shadow:
    0 10px 30px rgba(23, 43, 77, 0.16),
    0 2px 6px rgba(23, 43, 77, 0.08);
}

.risk-grid-filter-popup .ag-filter,
.risk-grid-filter-popup .ag-filter-wrapper,
.risk-grid-filter-popup .ag-set-filter {
  box-sizing: border-box;
  width: 100%;
  min-width: 0 !important;
  max-width: 100%;
  background: #ffffff;
}


/* ==========================================================
   SEARCH
   ========================================================== */

.risk-grid-filter-popup .ag-mini-filter {
  min-width: 0 !important;
  margin: 10px;
}

.risk-grid-filter-popup .ag-mini-filter .ag-input-wrapper {
  box-sizing: border-box;
  min-width: 0 !important;
  min-height: 34px;
  border: 1px solid #cad6e2;
  border-radius: 6px;
  background: #ffffff;
  box-shadow: none;
}

.risk-grid-filter-popup
  .ag-mini-filter
  .ag-input-wrapper:focus-within {
  border-color: #1684b8;
  box-shadow: 0 0 0 2px rgba(22, 132, 184, 0.14);
}

.risk-grid-filter-popup
  .ag-mini-filter
  .ag-input-field-input {
  min-width: 0;
  color: #243746;
  font-size: 13px;
}

.risk-grid-filter-popup
  .ag-mini-filter
  .ag-input-field-input::placeholder {
  color: #7b8998;
}


/* ==========================================================
   CHECKBOX LIST
   JavaScript adjusts the list height for available space.
   Do not set a fixed !important height here.
   ========================================================== */

.risk-grid-filter-popup .ag-set-filter-list {
  height: 280px;
  min-height: 0 !important;
  min-width: 0;
  margin: 0 8px 8px;
  flex: none;
}

/* Target the viewport directly, including when the viewport
   itself also has the ag-set-filter-list class. */
.risk-grid-filter-popup .ag-virtual-list-viewport {
  overflow-y: auto !important;
  overflow-x: hidden !important;
  scrollbar-gutter: stable;
  scrollbar-width: auto !important;
  scrollbar-color: #7b8da1 #edf2f7 !important;
}

.risk-grid-filter-popup
  .ag-virtual-list-viewport::-webkit-scrollbar {
  display: block !important;
  width: 10px !important;
}

.risk-grid-filter-popup
  .ag-virtual-list-viewport::-webkit-scrollbar-track {
  background: #edf2f7;
  border-radius: 5px;
}

.risk-grid-filter-popup
  .ag-virtual-list-viewport::-webkit-scrollbar-thumb {
  background: #7b8da1;
  border: 2px solid #edf2f7;
  border-radius: 5px;
}

.risk-grid-filter-popup
  .ag-virtual-list-viewport::-webkit-scrollbar-thumb:hover {
  background: #52677f;
}

/* Keep row heights controlled by filterParams.cellHeight. */
.risk-grid-filter-popup .ag-set-filter-item {
  padding-left: 6px;
  padding-right: 6px;
  border-radius: 4px;
}

.risk-grid-filter-popup .ag-set-filter-item:hover {
  background: #f0f6fb;
}

.risk-grid-filter-popup .ag-set-filter-item-checkbox {
  min-width: 0;
}

.risk-grid-filter-popup .ag-set-filter-item .ag-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #33465a;
  font-size: 13px;
}

.risk-grid-filter-popup .ag-set-filter-select-all {
  font-weight: 600;
}

.risk-grid-filter-popup .ag-filter-no-matches {
  color: #718096;
}


/* ==========================================================
   RESET / APPLY
   Assumes filterParams.buttons = ['reset', 'apply'].
   Buttons remain outside the scrolling checkbox list.
   ========================================================== */

.risk-grid-filter-popup .ag-filter-apply-panel {
  position: static;
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
  width: 100%;
  min-width: 0;
  padding: 10px;
  border-top: 1px solid #e5ebf1;
  background: #f8fafc;
}

.risk-grid-filter-popup .ag-filter-apply-panel-button {
  min-width: 68px;
  min-height: 30px;
  margin: 0 !important;
  padding: 5px 12px;
  border: 1px solid #cbd6e2;
  border-radius: 6px;
  background: #ffffff;
  color: #40566c;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

/* Reset */
.risk-grid-filter-popup
  .ag-filter-apply-panel-button:first-child:hover:not(:disabled) {
  border-color: #aabccd;
  background: #edf3f8;
}

/* Apply */
.risk-grid-filter-popup
  .ag-filter-apply-panel-button:last-child {
  border-color: #087fae;
  background: #087fae;
  color: #ffffff;
}

.risk-grid-filter-popup
  .ag-filter-apply-panel-button:last-child:hover:not(:disabled) {
  border-color: #06688f;
  background: #06688f;
}

.risk-grid-filter-popup
  .ag-filter-apply-panel-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.risk-grid-filter-popup
  .ag-filter-apply-panel-button:focus-visible {
  outline: 2px solid #1684b8;
  outline-offset: 2px;
}
