const groups = tooltipColumns?.groups ?? [];

const groupedRows = new Map<
  string,
  Record<string, number | undefined>
>();

contributionPoints.forEach((point) => {
  const seriesName = point.series.name;

  const group = groups.find((item) =>
    seriesName.toLowerCase().startsWith(item.toLowerCase())
  );

  if (!group) return;

  // "MC FXVG" -> "FXVG"
  // "Hist FXVG" -> "FXVG"
  const categoryName = seriesName
    .substring(group.length)
    .trim();

  if (!groupedRows.has(categoryName)) {
    groupedRows.set(categoryName, {});
  }

  groupedRows.get(categoryName)![group] = point.y ?? undefined;
});

***
const groupedHtml = Array.from(groupedRows.entries())
  .map(([category, values]) => `
    <tr>
      <td>${category}</td>

      ${groups
        .map(group => `
          <td>
            ${
              values[group] !== undefined
                ? Highcharts.numberFormat(
                    values[group]!,
                    valueDecimals ?? 1
                  )
                : '-'
            }
          </td>
        `)
        .join('')}
    </tr>
  `)
  .join('');

