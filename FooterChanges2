import type { ReactNode } from 'react';
import styles from './Footer.module.css';

type SideNavFooterProps = {
  collapsed: boolean;
  onToggle: () => void;
  supportEmail: string;
  footerNote?: ReactNode;
  poweredBy?: string;
};

export default function SideNavFooter({
  collapsed,
  onToggle,
  supportEmail,
  footerNote,
  poweredBy = 'Titan',
}: Readonly<SideNavFooterProps>) {
  const toggleLabel = collapsed
    ? 'Expand sidebar'
    : 'Collapse sidebar';

  return (
    <div
      className={styles.sideFooter}
      data-collapsed={collapsed}
    >
      <div className={styles.noteRow}>
        {!collapsed && footerNote && (
          <div className={styles.note}>
            <svg
              className={styles.icon}
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 11v6M12 7h.01" />
            </svg>

            <span>{footerNote}</span>
          </div>
        )}

        <button
          type="button"
          className={styles.toggle}
          onClick={onToggle}
          aria-label={toggleLabel}
          aria-expanded={!collapsed}
          title={toggleLabel}
        >
          <svg
            className={styles.icon}
            viewBox="0 0 24 24"
            aria-hidden="true"
            style={{
              transform: collapsed
                ? 'rotate(180deg)'
                : undefined,
            }}
          >
            <path d="m13 6-6 6 6 6m5-12-6 6 6 6" />
          </svg>
        </button>
      </div>

      <div className={styles.linksRow}>
        <a
          className={styles.support}
          href={`mailto:${supportEmail}`}
          aria-label="Email support"
          title={`Support: ${supportEmail}`}
        >
          <svg
            className={styles.icon}
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="5"
              width="18"
              height="14"
              rx="2"
            />
            <path d="m3 6 9 7 9-7" />
          </svg>

          {!collapsed && <span>Support</span>}
        </a>

        {poweredBy && (
          <span
            className={styles.poweredBy}
            title={`Powered by ${poweredBy}`}
            aria-label={`Powered by ${poweredBy}`}
          >
            <svg
              className={styles.icon}
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"
              />
              <path d="m8 12 3 3 5-6" />
            </svg>

            {!collapsed && (
              <span>Powered by {poweredBy}</span>
            )}
          </span>
        )}
      </div>
    </div>
  );
}
