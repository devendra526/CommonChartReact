return {
    chart: {
        ...CHART_INTERACTION_OPTIONS.chart,

        type: SERIES_TYPE_OF_CHART[type],

        height,

        spacingTop: 8,

        style: {
            fontFamily: 'inherit',
        },

        events: {
            fullscreenOpen: function (this: Highcharts.Chart) {
                this.setTitle({
                    text: title ?? '',
                    align: 'left',
                    style: {
                        fontSize: '16px',
                        fontWeight: '700',
                    },
                });

                setTimeout(() => {
                    this.reflow();
                }, 0);
            },

            fullscreenClose: function (this: Highcharts.Chart) {
                this.setTitle({
                    text: undefined,
                });

                setTimeout(() => {
                    this.reflow();
                }, 0);
            },
        },
    },

    exporting: CHART_INTERACTION_OPTIONS.exporting,

    credits: {
        enabled: false,
    },

    accessibility: {
        enabled: true,
    },

    title: {
        text: undefined,
    },

    subtitle: {
        text: subtitle ?? undefined,
        align: 'left',
    },

    // ...rest of your existing options


};


