formatter: function () {
  const points = this.points ?? [];

  const categoryIndex = points[0]?.point.x;

  const date =
    typeof categoryIndex === 'number'
      ? points[0]?.series.xAxis.categories?.[categoryIndex]
      : this.x;

  // Column/stack contributors only
  const contributionPoints = points.filter(
    (point) => point.series.type !== 'line'
  );

  // Trend line separately
  const trendPoint = points.find(
    (point) => point.series.type === 'line'
  );

  const total = contributionPoints.reduce(
    (sum, point) =>
      sum + (typeof point.y === 'number' ? point.y : 0),
    0
  );

  const rows = contributionPoints
    .map((point) => {
      const value =
        typeof point.y === 'number' ? point.y : 0;

      const percentage =
        total !== 0 ? (value / total) * 100 : 0;

      return `
        <tr>
          <td class="chart-tooltip-name">
            <span
              class="chart-tooltip-dot"
              style="background:${point.color}"
            ></span>
            ${point.series.name}
          </td>

          <td class="chart-tooltip-value">
            ${Highcharts.numberFormat(
              value,
              valueDecimals ?? 1
            )}
          </td>

          <td class="chart-tooltip-percent">
            ${Highcharts.numberFormat(percentage, 1)}%
          </td>
        </tr>
      `;
    })
    .join('');

  return `
    <div class="chart-tooltip">

      <div class="chart-tooltip-date">
        ${date ?? ''}
      </div>

      <table class="chart-tooltip-table">

        <thead>
          <tr>
            <th>Risk Type</th>
            <th>Value</th>
            <th>% of Total</th>
          </tr>
        </thead>

        <tbody>
          ${rows}
        </tbody>

        <tfoot>
          <tr class="chart-tooltip-total">
            <td>Total</td>

            <td>
              ${Highcharts.numberFormat(
                total,
                valueDecimals ?? 1
              )}
            </td>

            <td>100%</td>
          </tr>
        </tfoot>

      </table>

      ${
        trendPoint
          ? `
            <div class="chart-tooltip-trend">
              <span>CSVaR Trend</span>

              <strong>
                ${Highcharts.numberFormat(
                  trendPoint.y ?? 0,
                  valueDecimals ?? 1
                )}
              </strong>
            </div>
          `
          : ''
      }

    </div>
  `;
},

