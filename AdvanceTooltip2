.chart-tooltip {
  min-width: 300px;
  padding: 6px 8px;
  font-size: 12px;
  color: #202124;
}

.chart-tooltip-date {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
  padding-bottom: 7px;
  border-bottom: 1px solid #d9d9d9;
}

.chart-tooltip-table {
  width: 100%;
  border-collapse: collapse;
}

.chart-tooltip-table th {
  text-align: left;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 8px 5px 0;
}

.chart-tooltip-table td {
  padding: 2px 8px 2px 0;
}

.chart-tooltip-value,
.chart-tooltip-percent {
  text-align: right;
}

.chart-tooltip-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 7px;
}

.chart-tooltip-total td {
  border-top: 1px solid #d9d9d9;
  padding-top: 7px;
  font-weight: 700;
}

.chart-tooltip-trend {
  display: flex;
  justify-content: space-between;
  margin-top: 7px;
  padding-top: 7px;
  border-top: 1px solid #d9d9d9;
}

