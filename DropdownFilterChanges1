/* Dropdown popup */
.popup.popup {
  z-index: 100;
  box-sizing: border-box;
  min-width: 180px;
  max-height: 320px;
  overflow-y: auto;
  padding: 6px;

  background: #ffffff;
  border: 1px solid #dce4ef;
  border-radius: 10px;

  box-shadow:
    0 12px 28px rgba(15, 23, 42, 0.16),
    0 3px 8px rgba(15, 23, 42, 0.06);

  font-family: inherit;
  font-size: 12.5px;
  color: #334155;

  scrollbar-width: thin;
  scrollbar-color: #c4cfde transparent;
}

/* Remove default list spacing */
.popup.popup ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

/* Dropdown options */
.popup.popup li,
.popup.popup [role="option"] {
  position: relative;
  box-sizing: border-box;
  min-height: 30px;
  margin: 2px 0;
  padding: 6px 12px;

  list-style: none;
  border-radius: 6px;
  background: transparent;

  font-family: inherit;
  font-size: 12.5px;
  font-weight: 400;
  line-height: 18px;
  color: #334155;

  cursor: pointer;
  transition:
    background-color 120ms ease,
    color 120ms ease;
}

/* Hover */
.popup.popup li:hover,
.popup.popup [role="option"]:hover {
  background: #f1f5fb;
  color: #1d4ed8;
}

/* Keyboard focus */
.popup.popup li:focus-visible,
.popup.popup [role="option"]:focus-visible {
  outline: 2px solid #5b86f5;
  outline-offset: -2px;
  background: #f1f5fb;
}

/* Selected option */
.popup.popup li:global(.selected),
.popup.popup [role="option"]:global(.selected),
.popup.popup [aria-selected="true"] {
  background: #eaf1ff;
  color: #2457c5;
  font-weight: 600;
  box-shadow: inset 3px 0 0 #4f7df3;
}

/* Selected option on hover */
.popup.popup li:global(.selected):hover,
.popup.popup [role="option"]:global(.selected):hover,
.popup.popup [aria-selected="true"]:hover {
  background: #dfeaff;
}

/* Slim scrollbar */
.popup.popup::-webkit-scrollbar {
  width: 6px;
}

.popup.popup::-webkit-scrollbar-track {
  background: transparent;
}

.popup.popup::-webkit-scrollbar-thumb {
  background: #c4cfde;
  border: 1px solid #ffffff;
  border-radius: 6px;
}

.popup.popup::-webkit-scrollbar-thumb:hover {
  background: #9eafc5;
}
