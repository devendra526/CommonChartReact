/* =========================================================
   COMMON CHART - ADVANCED TOOLTIP
   ========================================================= */

.chart-tooltip {
  min-width: 260px;
  max-width: 420px;

  background: #ffffff;

  /*
   * Matches the blue top border used by dashboard cards
   */
  border-top: 3px solid #1f5fbf;

  border-radius: 8px;

  box-sizing: border-box;
  overflow: hidden;

  font-size: 13px;
  line-height: 1.35;

  color: #222222;
}


/* =========================================================
   DATE
   ========================================================= */

.chart-tooltip-date {
  padding: 9px 12px 8px;

  font-size: 16px;
  font-weight: 600;

  color: #222222;

  border-bottom: 1px solid #e3e6ea;

  background: #ffffff;
}


/* =========================================================
   CONTENT
   ========================================================= */

.chart-tooltip-content {
  padding: 7px 10px 8px;
}


/* =========================================================
   TABLE
   ========================================================= */

.chart-tooltip-table {
  width: 100%;

  border-collapse: collapse;
  border-spacing: 0;

  table-layout: auto;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

.chart-tooltip-table th {
  padding: 3px 5px 5px;

  font-size: 12px;
  font-weight: 600;

  color: #333333;

  white-space: nowrap;
}


/*
 * First column left aligned
 */
.chart-tooltip-table th:first-child {
  text-align: left;
}


/*
 * Numeric columns right aligned
 */
.chart-tooltip-table th:not(:first-child) {
  text-align: right;
}


/* =========================================================
   TABLE BODY
   ========================================================= */

.chart-tooltip-table td {
  padding: 2px 5px;

  font-size: 13px;

  vertical-align: middle;

  white-space: nowrap;
}


/* =========================================================
   FS TYPE COLUMN
   ========================================================= */

.chart-tooltip-name {
  text-align: left;

  display: flex;
  align-items: center;

  gap: 6px;

  padding-right: 12px !important;
}


/* =========================================================
   VALUE COLUMNS
   ========================================================= */

.chart-tooltip-number {
  text-align: right;

  font-variant-numeric: tabular-nums;

  padding-left: 8px !important;
}


/* =========================================================
   REDUCE SPACE BETWEEN COLUMNS
   ========================================================= */

/*
 * Single mode:
 *
 * FS Type | MC
 * FS Type | Hist
 */
.chart-tooltip-table-single th:first-child,
.chart-tooltip-table-single td:first-child {
  padding-right: 14px;
}

.chart-tooltip-table-single th:last-child,
.chart-tooltip-table-single td:last-child {
  padding-left: 8px;
}


/*
 * Both:
 *
 * FS Type | MC | Hist
 */
.chart-tooltip-table-both th:first-child,
.chart-tooltip-table-both td:first-child {
  padding-right: 12px;
}

.chart-tooltip-table-both th:nth-child(2),
.chart-tooltip-table-both td:nth-child(2) {
  padding-left: 8px;
  padding-right: 8px;
}

.chart-tooltip-table-both th:nth-child(3),
.chart-tooltip-table-both td:nth-child(3) {
  padding-left: 8px;
}


/* =========================================================
   COLORED SERIES DOT
   ========================================================= */

.chart-tooltip-dot {
  display: inline-block;

  width: 8px;
  height: 8px;

  min-width: 8px;

  border-radius: 50%;
}


/* =========================================================
   TREND SECTION
   ========================================================= */

.chart-tooltip-trends {
  margin-top: 7px;
  padding-top: 6px;

  border-top: 1px solid #e3e6ea;
}


.chart-tooltip-trend {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 3px 5px;

  font-size: 13px;
}


.chart-tooltip-trend-name {
  display: flex;
  align-items: center;

  gap: 6px;

  white-space: nowrap;
}


.chart-tooltip-trend strong {
  text-align: right;

  white-space: nowrap;

  font-weight: 600;

  font-variant-numeric: tabular-nums;
}


/*
 * Small line indicator instead of a round dot
 * for trend series.
 */
.chart-tooltip-line-marker {
  display: inline-block;

  width: 12px;
  height: 2px;

  min-width: 12px;
}


/* =========================================================
   LINE-ONLY CHART
   ========================================================= */

.chart-tooltip-line-only {
  min-width: 220px;
}


.chart-tooltip-line-list {
  padding: 7px 12px 9px;
}


.chart-tooltip-line-row {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 24px;

  padding: 3px 0;
}


.chart-tooltip-line-name {
  display: flex;

  align-items: center;

  gap: 7px;

  white-space: nowrap;
}


.chart-tooltip-line-value {
  text-align: right;

  white-space: nowrap;

  font-weight: 600;

  font-variant-numeric: tabular-nums;
}
