const toTooltipConfig = (
  config?: ApiTooltipConfig
): TooltipConfig | undefined => {
  if (!config) {
    return undefined;
  }

  return {
    mode: config.mode ?? 'table',

    categoryLabel: config.categoryLabel ?? 'Category',

    columns: config.columns ?? [],

    removeSeriesPrefixes:
      config.removeSeriesPrefixes ?? [],

    sortDescending:
      config.sortDescending ?? false,

    valueDecimals:
      config.valueDecimals ?? 1,

    footerSeriesMatcher: config.footerSeriesContains?.length
      ? (seriesName: string) => {
          const normalizedSeriesName = seriesName.toLowerCase();

          return config.footerSeriesContains!.some((text) =>
            normalizedSeriesName.includes(text.toLowerCase())
          );
        }
      : undefined,
  };
};

