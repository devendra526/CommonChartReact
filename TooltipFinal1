tooltip: advancedTooltip
  ? {
      shared: true,
      useHTML: true,
      outside: true,

      backgroundColor: '#ffffff',
      borderColor: '#d0d7de',
      borderRadius: 8,
      borderWidth: 1,

      shadow: true,
      padding: 0,

      formatter: function () {
        const points = this.points ?? [];

        if (!points.length) {
          return '';
        }

        /* -------------------------------------------------------
         * DATE
         * ----------------------------------------------------- */

        const categoryIndex = points[0]?.x;

        const date =
          typeof categoryIndex === 'number'
            ? points[0]?.series.xAxis.categories?.[categoryIndex]
            : this.x;

        /* -------------------------------------------------------
         * SEPARATE TREND SERIES
         *
         * Trend should NOT be part of the FS Type rows.
         * ----------------------------------------------------- */

        const trendPoint = points.find((point) => {
          const seriesType = point.series.type;
          const seriesName = point.series.name ?? '';

          return (
            seriesType === 'line' ||
            seriesName.toLowerCase().includes('trend')
          );
        });

        /* -------------------------------------------------------
         * CONTRIBUTION SERIES
         * ----------------------------------------------------- */

        const contributionPoints = points.filter((point) => {
          const seriesType = point.series.type;
          const seriesName = point.series.name ?? '';

          return (
            seriesType !== 'line' &&
            !seriesName.toLowerCase().includes('trend')
          );
        });

        /* -------------------------------------------------------
         * DETECT MC / HIST
         *
         * We intentionally DON'T depend on displayMode.
         *
         * Examples:
         *
         * MC FXDL
         * MC CMDL
         *
         * Hist FXDL
         * Hist CMDL
         * ----------------------------------------------------- */

        const hasMC = contributionPoints.some((point) =>
          (point.series.name ?? '')
            .trim()
            .toLowerCase()
            .startsWith('mc ')
        );

        const hasHist = contributionPoints.some((point) =>
          (point.series.name ?? '')
            .trim()
            .toLowerCase()
            .startsWith('hist ')
        );

        const isBoth = hasMC && hasHist;

        /* -------------------------------------------------------
         * NORMAL MODE HEADER
         *
         * MC only:
         * FS Type | MC
         *
         * Hist only:
         * FS Type | Hist
         *
         * Fallback:
         * FS Type | Value
         * ----------------------------------------------------- */

        const singleValueHeader = hasMC
          ? 'MC'
          : hasHist
            ? 'Hist'
            : 'Value';

        /* -------------------------------------------------------
         * HEADER
         * ----------------------------------------------------- */

        const header = isBoth
          ? `
              <tr>
                <th class="chart-tooltip-fstype">
                  FS Type
                </th>

                <th class="chart-tooltip-number">
                  MC
                </th>

                <th class="chart-tooltip-number">
                  Hist
                </th>
              </tr>
            `
          : `
              <tr>
                <th class="chart-tooltip-fstype">
                  FS Type
                </th>

                <th class="chart-tooltip-number">
                  ${singleValueHeader}
                </th>
              </tr>
            `;

        /* =======================================================
         * BOTH MODE
         *
         * Convert:
         *
         * MC FXDL
         * Hist FXDL
         *
         * into:
         *
         * FXDL | MC value | Hist value
         * ===================================================== */

        if (isBoth) {
          type GroupedValue = {
            name: string;
            mc?: number;
            hist?: number;
            color?: string;
          };

          const grouped = new Map<string, GroupedValue>();

          contributionPoints.forEach((point) => {
            const originalName = (point.series.name ?? '').trim();

            const lowerName = originalName.toLowerCase();

            const isMCSeries = lowerName.startsWith('mc ');

            const isHistSeries = lowerName.startsWith('hist ');

            /*
             * Remove MC / Hist only for display in first column.
             *
             * MC FXDL   -> FXDL
             * Hist FXDL -> FXDL
             */

            const cleanName = originalName
              .replace(/^mc\s+/i, '')
              .replace(/^hist\s+/i, '')
              .trim();

            if (!cleanName) {
              return;
            }

            const existing = grouped.get(cleanName) ?? {
              name: cleanName,
            };

            const value =
              typeof point.y === 'number'
                ? point.y
                : undefined;

            if (isMCSeries) {
              existing.mc = value;

              /*
               * Prefer MC color for the shared marker.
               */
              if (!existing.color) {
                existing.color = String(point.color);
              }
            }

            if (isHistSeries) {
              existing.hist = value;

              /*
               * If MC wasn't available, use Hist color.
               */
              if (!existing.color) {
                existing.color = String(point.color);
              }
            }

            grouped.set(cleanName, existing);
          });

          /* -----------------------------------------------------
           * Convert Map -> Array
           * --------------------------------------------------- */

          const groupedValues = Array.from(grouped.values());

          /* -----------------------------------------------------
           * SORT
           *
           * Highest available value first.
           *
           * You can remove this .sort() if you want the exact
           * original series order.
           * --------------------------------------------------- */

          groupedValues.sort((a, b) => {
            const aValue = Math.max(
              a.mc ?? Number.NEGATIVE_INFINITY,
              a.hist ?? Number.NEGATIVE_INFINITY
            );

            const bValue = Math.max(
              b.mc ?? Number.NEGATIVE_INFINITY,
              b.hist ?? Number.NEGATIVE_INFINITY
            );

            return bValue - aValue;
          });

          /* -----------------------------------------------------
           * CREATE BOTH-MODE ROWS
           * --------------------------------------------------- */

          const groupedHtml = groupedValues
            .map((item) => {
              const mcValue =
                typeof item.mc === 'number'
                  ? Highcharts.numberFormat(
                      item.mc,
                      valueDecimals ?? 1
                    )
                  : '-';

              const histValue =
                typeof item.hist === 'number'
                  ? Highcharts.numberFormat(
                      item.hist,
                      valueDecimals ?? 1
                    )
                  : '-';

              return `
                <tr>
                  <td class="chart-tooltip-fstype">
                    <span
                      class="chart-tooltip-marker"
                      style="background:${item.color ?? '#666'}"
                    ></span>

                    <span class="chart-tooltip-name">
                      ${item.name}
                    </span>
                  </td>

                  <td class="chart-tooltip-number">
                    ${mcValue}
                  </td>

                  <td class="chart-tooltip-number">
                    ${histValue}
                  </td>
                </tr>
              `;
            })
            .join('');

          /* -----------------------------------------------------
           * TREND
           * --------------------------------------------------- */

          const trendHtml = trendPoint
            ? `
                <div class="chart-tooltip-trend">
                  <span>
                    ${trendPoint.series.name ?? 'Trend'}
                  </span>

                  <strong>
                    ${Highcharts.numberFormat(
                      trendPoint.y ?? 0,
                      valueDecimals ?? 1
                    )}
                  </strong>
                </div>
              `
            : '';

          /* -----------------------------------------------------
           * RETURN BOTH TOOLTIP
           * --------------------------------------------------- */

          return `
            <div class="chart-tooltip">

              <div class="chart-tooltip-date">
                ${date ?? ''}
              </div>

              <div class="chart-tooltip-body">

                <table class="chart-tooltip-table chart-tooltip-table-both">

                  <thead>
                    ${header}
                  </thead>

                  <tbody>
                    ${groupedHtml}
                  </tbody>

                </table>

                ${trendHtml}

              </div>

            </div>
          `;
        }

        /* =======================================================
         * NORMAL MODE
         *
         * MC:
         *
         * FS Type | MC
         *
         * HIST:
         *
         * FS Type | Hist
         * ===================================================== */

        const rows = contributionPoints
          .map((point) => {
            const originalName = (point.series.name ?? '').trim();

            /*
             * Remove prefix if API/series happens to contain it.
             *
             * This keeps CommonChart defensive:
             *
             * MC FXDL -> FXDL
             * Hist FXDL -> FXDL
             */

            const cleanName = originalName
              .replace(/^mc\s+/i, '')
              .replace(/^hist\s+/i, '')
              .trim();

            const value =
              typeof point.y === 'number'
                ? point.y
                : 0;

            return {
              name: cleanName,
              value,
              color: String(point.color),
            };
          })

          /*
           * Highest value first.
           *
           * Remove sort if you want original legend order.
           */

          .sort((a, b) => b.value - a.value)

          .map(
            (item) => `
              <tr>

                <td class="chart-tooltip-fstype">

                  <span
                    class="chart-tooltip-marker"
                    style="background:${item.color}"
                  ></span>

                  <span class="chart-tooltip-name">
                    ${item.name}
                  </span>

                </td>

                <td class="chart-tooltip-number">

                  ${Highcharts.numberFormat(
                    item.value,
                    valueDecimals ?? 1
                  )}

                </td>

              </tr>
            `
          )
          .join('');

        /* -------------------------------------------------------
         * NORMAL TREND
         * ----------------------------------------------------- */

        const trendHtml = trendPoint
          ? `
              <div class="chart-tooltip-trend">

                <span>
                  ${trendPoint.series.name ?? 'Trend'}
                </span>

                <strong>
                  ${Highcharts.numberFormat(
                    trendPoint.y ?? 0,
                    valueDecimals ?? 1
                  )}
                </strong>

              </div>
            `
          : '';

        /* -------------------------------------------------------
         * RETURN NORMAL TOOLTIP
         * ----------------------------------------------------- */

        return `
          <div class="chart-tooltip">

            <div class="chart-tooltip-date">
              ${date ?? ''}
            </div>

            <div class="chart-tooltip-body">

              <table class="chart-tooltip-table chart-tooltip-table-single">

                <thead>
                  ${header}
                </thead>

                <tbody>
                  ${rows}
                </tbody>

              </table>

              ${trendHtml}

            </div>

          </div>
        `;
      },
    }
  : undefined,


