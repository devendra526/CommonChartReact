/* ============================================================
   COMMON CHART - ADVANCED TOOLTIP
   ============================================================ */

.chart-tooltip {
  min-width: 250px;
  max-width: 380px;

  background: #ffffff;

  color: #172033;

  font-size: 13px;
  line-height: 1.25;

  border-radius: 8px;

  overflow: hidden;
}


/* ============================================================
   DATE HEADER
   ============================================================ */

.chart-tooltip-date {
  padding: 9px 10px;

  font-size: 15px;
  font-weight: 600;

  color: #172033;

  background: #f6f7f9;

  border-bottom: 1px solid #e3e7ed;
}


/* ============================================================
   BODY
   ============================================================ */

.chart-tooltip-body {
  padding: 7px 8px 6px;
}


/* ============================================================
   TABLE
   ============================================================ */

.chart-tooltip-table {
  width: auto;

  border-collapse: collapse;
  border-spacing: 0;

  table-layout: auto;
}


/* ============================================================
   TABLE HEADER
   ============================================================ */

.chart-tooltip-table thead th {
  padding-top: 3px;
  padding-bottom: 5px;

  font-size: 12px;
  font-weight: 600;

  color: #374151;

  white-space: nowrap;
}


/* ============================================================
   ALL CELLS
   ============================================================ */

.chart-tooltip-table th,
.chart-tooltip-table td {
  padding-top: 2px;
  padding-bottom: 2px;

  vertical-align: middle;

  white-space: nowrap;
}


/* ============================================================
   FS TYPE COLUMN

   IMPORTANT:
   This is intentionally smaller than before.

   This reduces the large empty highlighted space between
   FS Type and MC / Hist.
   ============================================================ */

.chart-tooltip-table .chart-tooltip-fstype {
  width: 120px;
  min-width: 120px;
  max-width: 120px;

  padding-left: 4px;
  padding-right: 8px;

  text-align: left;
}


/* ============================================================
   FS TYPE NAME
   ============================================================ */

.chart-tooltip-name {
  vertical-align: middle;
}


/* ============================================================
   COLOR MARKER
   ============================================================ */

.chart-tooltip-marker {
  display: inline-block;

  width: 8px;
  height: 8px;

  margin-right: 6px;

  border-radius: 50%;

  vertical-align: middle;

  flex-shrink: 0;
}


/* ============================================================
   NUMBER COLUMNS

   Applies to:
   MC
   Hist
   Value fallback
   ============================================================ */

.chart-tooltip-table .chart-tooltip-number {
  width: 58px;
  min-width: 58px;
  max-width: 58px;

  padding-left: 5px;
  padding-right: 5px;

  text-align: right;
}


/* ============================================================
   SINGLE MODE

   FS Type | MC

   OR

   FS Type | Hist
   ============================================================ */

.chart-tooltip-table-single {
  min-width: 190px;
}


/* ============================================================
   BOTH MODE

   FS Type | MC | Hist
   ============================================================ */

.chart-tooltip-table-both {
  min-width: 255px;
}


/* ============================================================
   BOTH MODE - SLIGHTLY TIGHTER NUMBER COLUMNS
   ============================================================ */

.chart-tooltip-table-both .chart-tooltip-number {
  width: 55px;
  min-width: 55px;
  max-width: 55px;

  padding-left: 4px;
  padding-right: 4px;
}


/* ============================================================
   TREND SECTION
   ============================================================ */

.chart-tooltip-trend {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 16px;

  margin-top: 6px;

  padding:
    7px
    5px
    3px;

  border-top: 1px solid #e3e7ed;

  font-weight: 600;

  color: #172033;
}


/* ============================================================
   TREND VALUE
   ============================================================ */

.chart-tooltip-trend strong {
  margin-left: auto;

  text-align: right;

  font-weight: 600;
}


/* ============================================================
   HIGHCHARTS TOOLTIP OVERRIDES
   ============================================================ */

.highcharts-tooltip {
  pointer-events: none;
}


/*
 * Highcharts creates an SVG/HTML tooltip container.
 * Keep our custom HTML clean.
 */

.highcharts-tooltip > span {
  overflow: visible !important;
}


/* ============================================================
   FULLSCREEN
   ============================================================ */

.highcharts-container.is-chart-fullscreen .chart-tooltip {
  font-size: 14px;
}

.highcharts-container.is-chart-fullscreen
  .chart-tooltip-date {
  font-size: 16px;
}

.highcharts-container.is-chart-fullscreen
  .chart-tooltip-table thead th {
  font-size: 13px;
}
